# LOOM 3D Virtual Atelier - Environment Configuration Template
# Copy this file to .env and populate with your credentials

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Payaza Payment Gateway (Escrow Integration)
PAYAZA_API_KEY=payaza_sandbox_api_key_here
PAYAZA_SECRET_KEY=payaza_sandbox_secret_key_here
PAYAZA_MERCHANT_CODE=PZ_MERCHANT_001
PAYAZA_ENV=sandbox

# Supabase Third-Party Integration (Auth & Digital Twin Database)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Vercel Deployment Settings
VERCEL_ENV=development
KORA_PUBLIC_KEY=kora_test_public_key
KORA_SECRET_KEY=kora_test_secret_key

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
